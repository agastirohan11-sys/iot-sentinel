# Backend; run from backend/ (or supply an absolute SQLite path)
DATABASE_URL=sqlite:///./sentinel.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Frontend variables must be placed in frontend/.env
VITE_API_URL=http://127.0.0.1:8000

# Optional physical-device ingestion key (leave blank for trusted-LAN development)
DEVICE_API_KEY=
